{
  "name": "@ruleswitch/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "corepack pnpm --filter @ruleswitch/core run build && tsc -p tsconfig.json --noEmit",
    "typecheck": "corepack pnpm --filter @ruleswitch/core run build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@monaco-editor/react": "catalog:",
    "@ruleswitch/core": "workspace:*",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "catalog:"
  }
}
